# React 19 is the root version, but several deps (@visx/*, @react-leaflet/*,
# @radix-ui/react-compose-refs) declare a strict ≤18 peer range. They work
# fine at runtime — react 19 is API-compatible with their use — but `npm ci`
# refuses to install on strict peer mode. Falling back to legacy resolution
# matches what local `npm install` does anyway.
legacy-peer-deps=true
